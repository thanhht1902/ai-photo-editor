# Local-only deployment. Load with: node --env-file=.env --experimental-strip-types server/main.ts
PORT=8787
# Keep loopback locally; Docker Compose sets 0.0.0.0 inside its container.
HOST=127.0.0.1
DATA_DIR=./data
# mock = synthetic test patch with explicit confirmation; http = configured real adapter.
PROVIDER_MODE=mock
# Both roles must implement docs/provider-contract.md. No vendor is assumed.
PLANNER_URL=
PLANNER_API_KEY=
EDITOR_URL=
EDITOR_API_KEY=
# Explicit opt-in for a trusted local HTTP service (otherwise HTTPS required).
ALLOW_LOCAL_PROVIDER_HTTP=false
PROVIDER_TIMEOUT_MS=120000
# ImageMagick 6 executable and LCMS-readable sRGB profile.
IM_CONVERT=convert
IM_IDENTIFY=identify
SRGB_PROFILE=/usr/share/color/icc/ghostscript/srgb.icc
